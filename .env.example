# Guitar2Tabs local environment
NEXT_PUBLIC_REAL_AUDIO_API_BASE=http://localhost:8002
REAL_AUDIO_API_BASE=http://localhost:8002

# Optional: analysis cache / metrics (defaults shown)
# ANALYSIS_RESULT_CACHE_TTL_SEC=3600
# ANALYSIS_RESULT_CACHE_MAXSIZE=256
# ANALYSIS_METRICS_LIMIT=200
# ANALYSIS_INFLIGHT_LOCK_TTL_SEC=3600
# ANALYSIS_INFLIGHT_LOCK_MAXSIZE=512

# Optional: cloud analysis forwarding (quality=cloud)
# CLOUD_ANALYSIS_API_BASE=https://your-cloud-analysis-host
# CLOUD_ANALYSIS_API_KEY=
# CLOUD_ANALYSIS_TIMEOUT_SEC=900

# Optional: use one of these when yt-dlp needs authenticated cookies.
# YTDLP_COOKIE_FILE=C:\path\to\cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
