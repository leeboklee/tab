# Guitar2Tabs local environment
NEXT_PUBLIC_REAL_AUDIO_API_BASE=http://localhost:8002
REAL_AUDIO_API_BASE=http://localhost:8002

# Optional: analysis cache / metrics (defaults shown)
# ANALYSIS_RESULT_CACHE_TTL_SEC=3600
# ANALYSIS_RESULT_CACHE_MAXSIZE=256
# ANALYSIS_METRICS_LIMIT=200
# ANALYSIS_INFLIGHT_LOCK_TTL_SEC=3600
# ANALYSIS_INFLIGHT_LOCK_MAXSIZE=512

# Optional: cloud analysis forwarding (quality=cloud)
# CLOUD_ANALYSIS_API_BASE=https://your-cloud-analysis-host
# CLOUD_ANALYSIS_API_KEY=
# CLOUD_ANALYSIS_TIMEOUT_SEC=900

# Optional: use one of these when yt-dlp needs authenticated cookies.
# Prefer a throwaway Google account. Datacenter/cloud IPs often still fail without cookies+PO Token.
# YTDLP_COOKIE_FILE=/absolute/path/to/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_SLEEP_REQUESTS=0.5

# Optional: max upload size for /upload-audio and /analyze-upload (friend-friendly path)
# UPLOAD_AUDIO_MAX_MB=80

# Optional: PO Token provider (pip install bgutil-ytdlp-pot-provider) + HTTP server on :4416
# See https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide

# Optional: YouTube extraction on cloud/datacenter IPs (friend URL-only path)
# YTDLP_USE_TOR=true
# YTDLP_AUTO_TOR=true
# YTDLP_START_POT_PROVIDER=true
# YTDLP_PROXY=socks5h://127.0.0.1:9050
# YTDLP_TOR_SOCKS=socks5h://127.0.0.1:9050
# YTDLP_NODE_PATH=/exec-daemon/node
